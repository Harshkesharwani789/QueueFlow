{
  "name": "queueflow",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A reliable asynchronous job-processing platform.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "bcrypt": "5.1.1",
    "bullmq": "5.52.3",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "pino": "9.7.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.19",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.28.0",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "prisma": "6.7.0",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0",
    "vitest": "3.2.2"
  }
}
